<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>Top / Latest Overlay</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Noto+Sans+Thai:wght@300;400;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{--accent:#e8a4c8;--accent2:#c87eb0;--glow:rgba(232,164,200,0.4)}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:transparent;width:1920px;height:1080px;overflow:hidden;position:relative;}

  /* stack anchored bottom-left, same corner OBS users typically dock this kind of widget */
  #stack{position:absolute;left:40px;bottom:40px;display:flex;flex-direction:column;gap:14px;width:520px;}

  .row{
    display:flex;align-items:center;gap:16px;
    background:rgba(10,2,8,0.72);
    border:1px solid rgba(232,164,200,0.25);
    border-radius:16px;
    padding:14px 20px;
    opacity:0;transform:translateY(14px);
    transition:opacity .5s ease, transform .5s cubic-bezier(0.2,0,0,1), box-shadow .3s ease, border-color .3s ease;
    box-shadow:0 10px 40px rgba(0,0,0,0.5);
    backdrop-filter:blur(6px);
  }
  .row.show{opacity:1;transform:translateY(0);}
  .row.pulse{box-shadow:0 0 0 2px var(--accent),0 10px 50px var(--glow);border-color:var(--accent);}

  .icon{
    font-size:30px;flex-shrink:0;width:44px;height:44px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    background:radial-gradient(circle,rgba(232,164,200,0.22),transparent 70%);
  }
  .info{flex:1;min-width:0;}
  .tag{
    font-family:'Noto Sans Thai',sans-serif;font-size:13px;font-weight:700;
    letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);
    text-shadow:0 2px 14px rgba(0,0,0,0.7);margin-bottom:2px;
  }
  .name{
    font-family:'Cormorant Garamond',serif;font-size:30px;font-weight:600;color:#fff;
    line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    text-shadow:0 2px 20px rgba(0,0,0,0.8);
  }
  .amt{
    font-family:'DM Mono',monospace;font-size:26px;font-weight:500;color:var(--accent);
    flex-shrink:0;text-shadow:0 2px 20px rgba(0,0,0,0.7);
    filter:drop-shadow(0 0 14px var(--glow));
  }

  #dot{position:fixed;bottom:12px;right:12px;width:8px;height:8px;border-radius:50%;background:#444;z-index:999;transition:background .3s}
  #testBtn{position:fixed;bottom:12px;right:26px;padding:6px 14px;border:1px solid rgba(232,164,200,0.3);border-radius:8px;background:rgba(10,2,8,0.8);color:rgba(232,164,200,0.7);font-size:11px;cursor:pointer;font-family:'DM Mono',monospace;z-index:999;}
  #testBtn:hover{border-color:var(--accent);color:var(--accent)}
</style>
</head>
<body>

<div id="stack">
  <div class="row" id="rowTop">
    <div class="icon">👑</div>
    <div class="info">
      <div class="tag">Top Donation</div>
      <div class="name" id="topName">-</div>
    </div>
    <div class="amt" id="topAmt">฿0</div>
  </div>
  <div class="row" id="rowNew">
    <div class="icon">✨</div>
    <div class="info">
      <div class="tag">New Donation</div>
      <div class="name" id="newName">-</div>
    </div>
    <div class="amt" id="newAmt">฿0</div>
  </div>
</div>

<div id="dot" title="realtime status"></div>
<button id="testBtn" onclick="testDonation()">⟳ Test</button>

<script>
const SUPABASE_URL  = 'https://idmnppkltddrfxwhvnwa.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlkbW5wcGtsdGRkcmZ4d2h2bndhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAyMTI2ODQsImV4cCI6MjA5NTc4ODY4NH0.p5JYw0boVmoKLACbLcRwK3FeO9yLZi1HSd7N_1c5Lu0';

let currentTopTotal = -1;

async function init(){
  try{
    const s = await fetch('/api/settings').then(r=>r.json());
    document.documentElement.style.setProperty('--accent', s.accentColor || '#e8a4c8');
    document.documentElement.style.setProperty('--accent2', (s.accentColor||'#e8a4c8')+'cc');
    document.documentElement.style.setProperty('--glow', hexToRgba(s.accentColor||'#e8a4c8', 0.4));
  }catch(e){}
  await loadTop();
  connectRealtime();
}

function hexToRgba(hex,a){
  const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}

async function loadTop(){
  try{
    const top = await fetch('/api/top?t='+Date.now()).then(r=>r.json());
    if(top && top.length){
      const t = top[0];
      const changed = Number(t.total) !== currentTopTotal;
      currentTopTotal = Number(t.total);
      document.getElementById('topName').textContent = t.name;
      document.getElementById('topAmt').textContent = '฿'+Number(t.total).toLocaleString();
      showRow('rowTop', changed);
    }
  }catch(e){console.warn('[top-latest] loadTop',e);}
}

function showRow(id, pulse){
  const el = document.getElementById(id);
  el.classList.add('show');
  if(pulse){
    el.classList.add('pulse');
    setTimeout(()=>el.classList.remove('pulse'), 1600);
  }
}

function connectRealtime(){
  const script=document.createElement('script');
  script.src='https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js';
  script.onload=()=>{
    const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON);
    sb.channel('donations')
      .on('broadcast',{event:'new_donation'},({payload})=>{
        console.log('[top-latest] new donation:',payload);
        showLatest(payload);
        setTimeout(loadTop, 1200); // totals update server-side, give it a beat
      })
      .on('broadcast',{event:'settings_update'},({payload})=>{
        if(payload.accentColor){
          document.documentElement.style.setProperty('--accent',payload.accentColor);
          document.documentElement.style.setProperty('--glow',hexToRgba(payload.accentColor,0.4));
        }
      })
      .subscribe(status=>{
        console.log('[top-latest] status:',status);
        document.getElementById('dot').style.background = status==='SUBSCRIBED' ? 'var(--accent)' : '#444';
      });
  };
  document.head.appendChild(script);
}

function showLatest({name, amount}){
  document.getElementById('newName').textContent = name;
  document.getElementById('newAmt').textContent = '฿'+Number(amount).toLocaleString();
  showRow('rowNew', true);
}

function testDonation(){
  showLatest({name:'TestUser', amount: Math.floor(Math.random()*500)+10});
}

// refresh top periodically in case of external changes (admin edits, etc.)
setInterval(loadTop, 30000);
init();
</script>
</body>
</html>
